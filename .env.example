# CWSandbox Client - Integration Test Credentials
# Copy to .env and uncomment the auth option you want to use.
# .env is gitignored; .env.example is committed for documentation.
#
# Quick start:
#   cp .env.example .env
#   # Edit .env with your credentials
#   uv run pytest tests/integration/ -v

# =============================================================================
# Required: CWSandbox API Key
# =============================================================================
# CWSANDBOX_API_KEY=your-cwsandbox-api-key

# =============================================================================
# Optional: W&B API key for live metrics verification in
# tests/integration/cwsandbox/test_wandb.py
# =============================================================================
# WANDB_API_KEY=your-wandb-api-key

# =============================================================================
# Optional: API Endpoint Override
# =============================================================================
# CWSANDBOX_BASE_URL=https://api.cwsandbox.com

# =============================================================================
# Optional: Pin e2e sandboxes to specific runner(s)
# =============================================================================
# Comma-separated list. Overridden by `--cwsandbox-runner-ids=<csv>` on the
# pytest command line; pass the flag with an empty value to auto-schedule.
# CWSANDBOX_TEST_RUNNER_IDS=runner-a,runner-b

# =============================================================================
# Optional: Private-registry template create (tests/integration/.../test_image_pull_credentials.py)
# =============================================================================
# Required together. Template create also needs a key that can write
# organization templates. If template CRUD is on a different host than
# CWSANDBOX_BASE_URL, set CWSANDBOX_TEST_TEMPLATE_BASE_URL.
# CWSANDBOX_TEST_PRIVATE_REGISTRY_IMAGE=registry.example.com:5000/private-app:latest
# CWSANDBOX_TEST_PRIVATE_REGISTRY=registry.example.com:5000
# CWSANDBOX_TEST_PRIVATE_REGISTRY_STORE=wandb
# CWSANDBOX_TEST_PRIVATE_REGISTRY_SECRET=registry-creds
# CWSANDBOX_TEST_PRIVATE_REGISTRY_FIELD=token
# CWSANDBOX_TEST_TEMPLATE_BASE_URL=http://localhost:8090
